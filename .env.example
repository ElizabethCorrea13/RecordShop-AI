# Plantilla de variables de entorno del backend.
# Copiar a backend/.env y completar con la clave real. El archivo .env NUNCA se commitea.

# API key de Google Gemini (nivel gratuito). Se consigue gratis en
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional. Por default usa el alias "gemini-flash-latest" (siempre el
# Flash vigente). Descomentar solo para fijar una versión puntual.
# GEMINI_MODEL=gemini-2.5-flash

# Solo hace falta en producción: la URL del frontend deployado (ej. Vercel),
# para que CORS lo deje llamar a esta API. En local no se usa — localhost
# ya está permitido sin esto (ver main.py).
# ALLOWED_ORIGIN=https://recordshop-ai.vercel.app
